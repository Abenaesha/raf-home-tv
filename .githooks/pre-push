#!/bin/sh
# On `git push`: if the pushed commits change release/raf-home.wgt, install it on the TV.
# Never blocks the push: a TV that is off or an install that fails only prints a warning.
# Skip once with:  RAF_NO_DEPLOY=1 git push
[ -n "${RAF_NO_DEPLOY:-}" ] && exit 0

ZERO=0000000000000000000000000000000000000000
changed=no
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue            # deleting a branch
    if [ "$remote_sha" = "$ZERO" ]; then
        changed=yes                                    # new branch: install
    elif git cat-file -e "$remote_sha" 2>/dev/null; then
        if [ -n "$(git diff --name-only "$remote_sha" "$local_sha" -- release/raf-home.wgt)" ]; then
            changed=yes
        fi
    else
        changed=yes                                    # remote commit unknown here: install to be safe
    fi
done

if [ "$changed" = yes ]; then
    sh "$(git rev-parse --show-toplevel)/scripts/deploy.sh" || \
        echo "raf-home: TV not updated; the push continues. Retry with: npm run deploy"
else
    echo "raf-home: no new TV package in this push, skipping install."
fi
exit 0
