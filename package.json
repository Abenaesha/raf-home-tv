{
  "name": "arn0-tv-launcher",
  "version": "0.2.0",
  "private": true,
  "description": "Minimal remote-friendly launcher for a Samsung Tizen TV",
  "scripts": {
    "preview": "node scripts/serve.mjs",
    "build": "sh scripts/build.sh",
    "devlog": "node scripts/devlog-server.mjs",
    "icon": "node scripts/make-icon.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "release": "sh scripts/build.sh && cp dist/arn0-launcher.wgt release/raf-home.wgt",
    "deploy": "sh scripts/deploy.sh",
    "setup-cli": "sh scripts/setup-cli.sh"
  }
}
